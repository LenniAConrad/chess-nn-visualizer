# Build directories and CMake output
/build/
/out/
/cmake-build-*/
/CMakeFiles/
/CMakeCache.txt
/CMakeUserPresets.json
/CTestTestfile.cmake
/Testing/
/CPackConfig.cmake
/CPackSourceConfig.cmake
/Makefile
/cmake_install.cmake
