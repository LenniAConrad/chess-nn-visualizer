digraph CppNnVisualizer {
  graph [
    rankdir=LR,
    splines=polyline,
    nodesep=0.55,
    ranksep=0.9,
    fontname="DejaVu Sans"
  ];
  node [shape=record, fontname="DejaVu Sans", fontsize=10];
  edge [fontname="DejaVu Sans", fontsize=9];

  subgraph cluster_chess {
    label="chess";
    color="#9aa6b2";

    Piece [label="{Piece|+ color : Color\l+ type : PieceType\l|+ isNone() : bool\l}"];
    Move [label="{Move|- m_value : uint16_t\l|+ from() : Square\l+ to() : Square\l+ promotion() : Promotion\l+ toUci() : string\l}"];
    MoveList [label="{MoveList|- m_moves[256] : Move\l- m_size : size_t\l|+ push(Move)\l+ clear()\l+ size() : size_t\l}"];
    StateInfo [label="{StateInfo|+ capturedPiece : Piece\l+ prevCastlingRights : uint8_t\l+ prevEpSquare : Square\l+ prevHalfmoveClock : int\l+ moveMade : Move\l}"];
    Position [label="{Position|- m_pieces[2][6]\l- m_byColor[2]\l- m_occupied : Bitboard\l- m_board[64] : Piece\l- m_history : vector of StateInfo\l- m_hashHistory : vector of uint64_t\l|+ make(Move)\l+ unmake()\l+ inCheck() : bool\l+ hash() : uint64_t\l}"];
    Fen [label="{Fen|utility|+ parse(string) : optional Position\l+ format(Position) : string\l}"];
    San [label="{San|utility|+ toSan(Position, Move) : string\l+ parse(Position, string) : Move\l}"];
    MoveGenerator [label="{MoveGenerator|utility|+ generateLegal(Position&, MoveList&)\l}"];
    PositionEditor [label="{PositionEditor|- m_position : Position\l|+ placePiece(Square, Piece)\l+ validate() : vector of string\l+ fen() : string\l}"];
    ClassicalEval [label="{eval::Classical|utility|+ evaluateWhiteBreakdown(Position) : Breakdown\l+ evaluateWdl(Position) : WdlTriplet\l+ pieceSquareHeatmap(Position) : array of 64 floats\l}"];
  }

  subgraph cluster_game {
    label="game";
    color="#9aa6b2";

    MoveRecord [label="{MoveRecord|+ move : Move\l+ fenBefore : string\l+ fenAfter : string\l+ san : string\l+ prev : MoveRecord*\l+ next : MoveRecord*\l}"];
    MoveHistory [label="{MoveHistory|- m_head : MoveRecord*\l- m_current : MoveRecord*\l|+ pushMove(MoveRecord)\l+ undo() : MoveRecord*\l+ redo() : MoveRecord*\l+ clear()\l}"];
    Game [label="{Game|- m_position : Position\l- m_history : MoveHistory\l|+ tryMove(Move) : bool\l+ loadFen(string) : bool\l+ undo() : bool\l+ redo() : bool\l+ status() : GameStatus\l}"];
  }

  subgraph cluster_nn {
    label="nn";
    color="#9aa6b2";

    Tensor [label="{Tensor T Rank|- m_data : vector of T\l- m_shape : array of size_t\l- m_strides : array of size_t\l|+ reshape(Shape)\l+ at(...) : T&\l+ data() : T*\l}"];
    ActivationSnapshot [label="{ActivationSnapshot|- m_entries : unordered_map string to Entry\l|+ store(key, shape, data)\l+ find(key) : Entry*\l+ size(key) : size_t\l}"];
    INetwork [label="{INetwork|abstract|+ load(path)\l+ evaluate(Position, Snapshot)\l+ name() : string\l}"];
    NnueNetwork [label="{nnue::Network|- m_weights : Weights\l|+ load(path)\l+ evaluate(pos, out)\l+ hiddenSize() : size_t\l}"];
    CnnNetwork [label="{lc0_cnn::Network|- m_weights : Weights\l- m_policyReverse : vector of int\l|+ load(path)\l+ evaluate(pos, out)\l+ policyIndexForMove(pos, move) : int\l}"];
    Bt4Network [label="{lc0_bt4::Network|- m_realLoaded : bool\l- m_realWeights : Bt4RealWeights\l|+ load(path)\l+ evaluate(pos, out)\l+ hasRealWeights() : bool\l}"];
    Bt4Loader [label="{loadBt4Real|function|+ parse BT4J v2 weights\l}"];
  }

  subgraph cluster_search {
    label="search";
    color="#9aa6b2";

    LeafEval [label="{LeafEval|+ value : float\l+ priors : vector of float\l}"];
    Mcts [label="{Mcts|- m_nodes : vector of Node\l- m_stats : vector of Stats\l- m_statsBySignature : unordered_map hash to int\l|+ iterate()\l+ bestMove() : Move\l+ rootCentipawns() : int\l+ snapshot(...) : Snapshot\l}"];
    SearchSnapshot [label="{Snapshot|+ nodes : vector of SnapshotNode\l+ playouts : long\l+ bestUci : string\l+ pv : vector of uint16_t\l+ exploringFen : string\l}"];
  }

  subgraph cluster_io {
    label="io";
    color="#9aa6b2";

    Config [label="{Config|- m_values : map string to string\l|+ load(path) : bool\l+ save(path) : bool\l+ getString(key, fallback)\l+ getInt(key, fallback)\l}"];
    WeightFileReader [label="{WeightFileReader|- m_stream : ifstream\l- m_path : string\l- m_size : size_t\l|+ open(path, magic)\l+ read_u32() : uint32_t\l+ read_f32_array(dst, count)\l}"];
  }

  subgraph cluster_viz {
    label="viz";
    color="#9aa6b2";

    App [label="{App|- m_game : Game\l- m_config : Config\l- m_nnue/m_cnn/m_bt4\l- m_board : BoardView\l- m_treeView : TreeView\l|+ run() : int\l- handleInput()\l- render()\l- selectArchitecture(Arch)\l- startMcts()\l}"];
    BoardView [label="{BoardView|- m_position : Position*\l- m_bounds : Rectangle\l- m_overlay[64] : float\l|+ draw(theme)\l+ squareAtPixel(pixel)\l+ setActivationOverlay(values)\l}"];
    Controls [label="{Controls|- m_buttons : vector of Button\l|+ addButton(label, callback, active)\l+ update()\l+ draw(theme)\l}"];
    IActivationView [label="{IActivationView|abstract|+ update(snapshot)\l+ setBounds(rect)\l+ draw(theme)\l+ name() : string\l}"];
    NnueView [label="{NnueView|draws NNUE modes\l}"];
    CnnView [label="{CnnView|draws CNN modes\l}"];
    Bt4View [label="{Bt4View|draws BT4 modes\l+ setPosition(Position*)\l+ setSprites(PieceSprites*)\l}"];
    ClassicalView [label="{ClassicalView|- m_breakdown : Breakdown\l- m_wdl : WdlTriplet\l|+ setPosition(Position)\l+ draw(theme)\l}"];
    TreeView [label="{TreeView|- m_snap : Snapshot\l- m_display : vector of DisplayNode\l|+ setSnapshot(Snapshot)\l+ fit()\l+ update()\l+ draw(theme)\l}"];
  }

  Position -> Piece [label="contains"];
  Position -> StateInfo [label="history"];
  MoveList -> Move [label="array"];
  Fen -> Position [style=dashed, label="parse/format"];
  San -> Position [style=dashed, label="reads"];
  MoveGenerator -> Position [style=dashed, label="uses"];
  MoveGenerator -> MoveList [style=dashed, label="fills"];
  PositionEditor -> Position [label="wraps"];
  ClassicalEval -> Position [style=dashed, label="evaluates"];

  Game -> Position [label="owns"];
  Game -> MoveHistory [label="owns"];
  MoveHistory -> MoveRecord [label="linked nodes"];
  MoveRecord -> Move [label="stores"];

  INetwork -> NnueNetwork [arrowhead=empty, label="implemented by"];
  INetwork -> CnnNetwork [arrowhead=empty, label="implemented by"];
  INetwork -> Bt4Network [arrowhead=empty, label="implemented by"];
  NnueNetwork -> ActivationSnapshot [style=dashed, label="stores"];
  CnnNetwork -> ActivationSnapshot [style=dashed, label="stores"];
  Bt4Network -> ActivationSnapshot [style=dashed, label="stores"];
  Bt4Loader -> Bt4Network [style=dashed, label="loads real weights"];
  WeightFileReader -> NnueNetwork [style=dashed, label="loads"];
  WeightFileReader -> CnnNetwork [style=dashed, label="loads"];
  WeightFileReader -> Bt4Network [style=dashed, label="loads BT4V"];

  Mcts -> LeafEval [style=dashed, label="callback result"];
  Mcts -> SearchSnapshot [label="emits"];
  Mcts -> Position [label="searches"];

  App -> Game [label="owns"];
  App -> Config [label="owns"];
  App -> BoardView [label="owns"];
  App -> Controls [label="owns"];
  App -> INetwork [style=dashed, label="evaluates"];
  App -> IActivationView [style=dashed, label="updates"];
  App -> Mcts [label="worker owns"];
  App -> TreeView [label="owns"];
  IActivationView -> NnueView [arrowhead=empty];
  IActivationView -> CnnView [arrowhead=empty];
  IActivationView -> Bt4View [arrowhead=empty];
  IActivationView -> ClassicalView [arrowhead=empty];
  ClassicalView -> ClassicalEval [style=dashed, label="uses"];
  TreeView -> SearchSnapshot [label="renders"];
  BoardView -> Position [style=dashed, label="reads"];
  Bt4View -> Position [style=dashed, label="piece overlay"];
}
